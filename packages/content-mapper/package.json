{
  "name": "@css-modules-kit/content-mapper",
  "version": "0.0.0",
  "private": false,
  "description": "A TypeScript content mapper for CSS Modules",
  "keywords": [
    "css-modules",
    "typescript"
  ],
  "license": "MIT",
  "author": "mizdra <pp.mizdra@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizdra/css-modules-kit.git",
    "directory": "packages/content-mapper"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/test",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@css-modules-kit/core": "workspace:*",
    "vscode-jsonrpc": "^10.0.0"
  },
  "devDependencies": {
    "typescript-nightly": "npm:typescript@7.1.0-dev.20261030.1"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/main.js"
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
